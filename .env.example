# Render environment variables. Never commit real secrets.
CLIENT_ID=your_discord_application_id
CLIENT_SECRET=your_discord_oauth2_client_secret
DISCORD_TOKEN=your_discord_bot_token
REDIRECT_URI=https://YOUR-RENDER-SERVICE.onrender.com/auth/callback
DATABASE_URL=your_postgres_connection_string

# Optional: set DATABASE_SSL=true if your PostgreSQL provider requires TLS.
DATABASE_SSL=false
# Optional. If omitted, CLIENT_SECRET is used to sign short-lived OAuth state.
STATE_SECRET=replace_with_a_long_random_secret
